# Backend selection: "ollama" (default), "llamacpp", or "gemini"
BACKEND=llamacpp

# --- Ollama backend settings ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=fredrezones55/Qwen3.5-APEX:latest

# --- llama.cpp server backend settings ---
# Set BACKEND=llamacpp and configure these when using llama.cpp instead of Ollama.
LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1
LLAMACPP_MODEL=Qwen3.5-35B-A3B-Tier15-s.gguf

# --- Gemini backend settings ---
# Set BACKEND=gemini and configure these when using Google Gemini API.
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Batch size: process multiple PDF pages in one request
# Higher = fewer API calls, but must stay under TPM limit
# Rate limiter automatically handles token constraints
GEMINI_BATCH_SIZE=20
# Your tier limits (check Google AI Studio for your actual limits)
# Free tier: 10 RPM, 65K TPM
# Paid tier example: 12 RPM, 220K TPM
GEMINI_RPM_LIMIT=12
GEMINI_TPM_LIMIT=220000
# Safety margin: use 90% of limits to avoid hitting caps (0.5-1.0)
GEMINI_SAFETY_MARGIN=0.9
# Request timeout in seconds (increase for large batches)
GEMINI_TIMEOUT_SECONDS=600
# Fallback to local (Ollama/llama.cpp) if Gemini fails
GEMINI_FALLBACK_TO_LOCAL=true
# Which local backend to use for Gemini fallback: "ollama" or "llamacpp"
# Defaults to ollama if not set — set explicitly when your local backend is llama.cpp
GEMINI_LOCAL_FALLBACK_BACKEND=llamacpp
# Max output tokens per Gemini request (keep in sync with batch size — 8192 fits ~3-5 dense pages)
GEMINI_MAX_OUTPUT_TOKENS=8192


# --- Shared settings ---
PUBLIC_MODEL_NAME=ollama-ocr
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_NUM_PREDICT=8192
OCR_DEBUG=true
MAX_UPLOAD_MB=400
MAX_PDF_PAGES=10000
VIDEO_MAX_UPLOAD_MB=200
VIDEO_MAX_DURATION_SECONDS=3600
VIDEO_SAMPLE_FPS=0.5
VIDEO_MIN_FRAMES=4
VIDEO_MAX_FRAMES=24
VIDEO_FRAME_MAX_DIMENSION=768
VIDEO_JPEG_QUALITY=5
VIDEO_FFMPEG_TIMEOUT_SECONDS=30

# --- Checkpoint settings ---
# Directory to store OCR checkpoints (processed pages cached by file hash)
CHECKPOINT_DIR=checkpoints
# Save checkpoint progress every N pages
CHECKPOINT_SAVE_INTERVAL=20
