# Backend selection: "ollama" (default) or "llamacpp"
BACKEND=llamacpp

# --- Ollama backend settings ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=fredrezones55/Qwen3.5-APEX:latest

# --- llama.cpp server backend settings ---
# Set BACKEND=llamacpp and configure these when using llama.cpp instead of Ollama.
LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1
LLAMACPP_MODEL=Qwen3.5-35B-A3B-Tier15-s.gguf

# --- Shared settings ---
PUBLIC_MODEL_NAME=ollama-ocr
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_NUM_PREDICT=8192
OCR_DEBUG=false
MAX_UPLOAD_MB=400
MAX_PDF_PAGES=10000
VIDEO_MAX_UPLOAD_MB=200
VIDEO_MAX_DURATION_SECONDS=3600
VIDEO_SAMPLE_FPS=0.5
VIDEO_MIN_FRAMES=4
VIDEO_MAX_FRAMES=24
VIDEO_FRAME_MAX_DIMENSION=768
VIDEO_JPEG_QUALITY=5
VIDEO_FFMPEG_TIMEOUT_SECONDS=30

# --- Checkpoint settings ---
# Directory to store OCR checkpoints (processed pages cached by file hash)
CHECKPOINT_DIR=checkpoints
# Save checkpoint progress every N pages
CHECKPOINT_SAVE_INTERVAL=20
